{
  "$schema": "https://raw.githubusercontent.com/nickel-org/tauri/next/crates/tauri-config-schema/schema.json",
  "productName": "Limpiador de audio",
  "version": "1.0.0",
  "identifier": "com.audio-processor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Limpiador de audio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/audio-backend"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
